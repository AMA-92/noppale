# Variables d'environnement pour Noppalé
# Copiez ce fichier en .env.local pour le développement local
# Pour Vercel, ajoutez ces variables dans les settings du projet

# Supabase Configuration
VITE_SUPABASE_URL=https://sewgwcxaenssloobnfjk.supabase.co
VITE_SUPABASE_ANON_KEY=votre_clé_anonyme_supabase

# Devise par défaut (FCFA, EUR, USD, etc.)
VITE_DEFAULT_CURRENCY=FCFA

# Assistant Backend (Vercel Serverless)
VITE_ASSISTANT_BACKEND_URL=https://noppale-assistant.vercel.app/api/assistant

# Assistant API Supabase (fallback)
VITE_ASSISTANT_FUNCTION_URL=https://sewgwcxaenssloobnfjk.supabase.co/functions/v1/assistant